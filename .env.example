# Frontend (Vite). Use Supabase's publishable key only; never a service-role/secret key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_TRADEQUEST_API_URL=http://localhost:4000

# Node API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Server-only API secret (never add this to a VITE_* variable or browser environment).
REPLAY_CURSOR_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Used for signed learner-bound synthetic replay and temporary paper-trade sessions; server-only.
